// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model UpsellCampaign {
  id           Int     @id @default(autoincrement())
  name         String
  type         String
  placement    String
  rewardMode   String
  rewardType   String
  discountCode String?
  discountType String?

  goalType     String?
  goalAmount   Int?
  goalquantity Int?
  currency     String?
  shop         String

  showConfetti    Boolean @default(false)
  showLockedGoals Boolean @default(false)

  badgeImageUrl String?
  barStyle      String
  barRadius     String
  barColors     Json

  goalText    String
  preGoalText String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 🔗 Relations
  triggerProducts        UpsellTriggerProduct[]
  triggerCollections     UpsellTriggerCollection[]
  rewardProducts         UpsellRewardProduct[]
  buyMoreRules           BuyMoreRule[]
  bogoRules              BogoRule[]
  bogoFreeItems          BogoFreeItem[]
  UpsellRewardCollection UpsellRewardCollection[]
  UpsellFreeGiftProduct  UpsellFreeGiftProduct[]
}

model UpsellTriggerProduct {
  id           Int     @id @default(autoincrement())
  campaignId   Int
  productId    String
  variantId    String?
  productTitle String
  handle       String
  price        String?
  media        String?

  campaign UpsellCampaign @relation(fields: [campaignId], references: [id])
}

model UpsellTriggerCollection {
  id           Int    @id @default(autoincrement())
  campaignId   Int
  collectionId String
  title        String
  handle       String

  campaign UpsellCampaign @relation(fields: [campaignId], references: [id])
}

model UpsellRewardProduct {
  id         Int     @id @default(autoincrement())
  campaignId Int
  productId  String
  variantId  String?
  title      String?
  price      String?
  media      String?

  campaign UpsellCampaign @relation(fields: [campaignId], references: [id])
}

model UpsellFreeGiftProduct {

  id         Int     @id @default(autoincrement())
  campaignId Int
  productId  String
  variantId  String?
  title      String?
  price      String?
  media      String?

  campaign UpsellCampaign @relation(fields: [campaignId], references: [id])
}

model UpsellRewardCollection {
  id           Int     @id @default(autoincrement())
  campaignId   Int
  collectionid String
  title        String?
  price        String?
  media        String?

  campaign UpsellCampaign @relation(fields: [campaignId], references: [id])
}

model BuyMoreRule {
  id           Int    @id @default(autoincrement())
  campaignId   Int
  productId    String
  quantity     Int
  discount     Float
  discountType String // 'percentage' | 'amount'

  campaign UpsellCampaign @relation(fields: [campaignId], references: [id])
}

model BogoRule {
  id         Int    @id @default(autoincrement())
  campaignId Int
  buyQty     String
  getQty     String

  campaign UpsellCampaign @relation(fields: [campaignId], references: [id])
}

model BogoFreeItem {
  id         Int    @id @default(autoincrement())
  campaignId Int
  productId  String
  variantId  String?
  title      String?
  price      String?
  media      String?

  campaign UpsellCampaign @relation(fields: [campaignId], references: [id])
}
