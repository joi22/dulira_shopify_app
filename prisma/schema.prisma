// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model UpsellCampaign {
  id        Int     @id @default(autoincrement())
  name      String
  type      String
  placement String
  status    String?
  shop      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  offers                 AddToUnlockOffer[]
  triggerProducts        UpsellTriggerProduct[]
  triggerCollections     UpsellTriggerCollection[]
  rewardProducts         UpsellRewardProduct[]
  rewardCollections      UpsellRewardCollection[]
  freeGiftProducts       UpsellFreeGiftProduct[]
  customization          customiz?
  BuyMoreRule            BuyMoreRule[]
  BogoRule               BogoRule[]
  BogoFreeItem           BogoFreeItem[]
  OrderBump              OrderBump[]
  CampaignTargetCountry  CampaignTargetCountry[]
  CampaignExcludeCountry CampaignExcludeCountry[]
  checkout_upsell        checkout_upsell[]
  PostPurchaseUpsell     PostPurchaseUpsell[]
}

model customiz {
  id            Int            @id @default(autoincrement())
  campaignId    Int            @unique
  badgeImageUrl String?
  barStyle      String
  barRadius     String
  barColors     Json
  campaign      UpsellCampaign @relation(fields: [campaignId], references: [id])
}

model AddToUnlockOffer {
  id         Int     @id @default(autoincrement())
  campaignId Int
  shop       String?

  // Goal
  goalType     String? // "amount_cart" | "quantity"
  goalAmount   Int?
  goalQuantity Int?

  // Reward
  rewardType     String? // "discount" | "gift"
  rewardMode     String? // "fixed" | "flame"
  discountType   String? // "percentage" | "amount"
  discountCode   Float?
  goalTextBefore String?
  goalTextAfter  String?

  // Relations
  rewardProducts    UpsellRewardProduct[]
  rewardCollections UpsellRewardCollection[]
  buyProducts       UpsellTriggerProduct[]
  buyCollections    UpsellTriggerCollection[]

  campaign UpsellCampaign @relation(fields: [campaignId], references: [id])

  BuyXProduct BuyXProduct[]
}

model BuyXProduct {
  id        Int     @id @default(autoincrement())
  offerId   Int
  productId String
  variantId String?
  title     String?

  offer AddToUnlockOffer @relation(fields: [offerId], references: [id])
}

model UpsellTriggerProduct {
  id           Int     @id @default(autoincrement())
  campaignId   Int
  shop         String?
  productId    String
  variantId    String?
  productTitle String
  handle       String
  price        String?
  media        String?

  campaign UpsellCampaign @relation(fields: [campaignId], references: [id])

  AddToUnlockOffer AddToUnlockOffer[]
}

model UpsellTriggerCollection {
  id           Int     @id @default(autoincrement())
  campaignId   Int
  shop         String?
  collectionId String
  title        String
  handle       String

  campaign UpsellCampaign @relation(fields: [campaignId], references: [id])

  AddToUnlockOffer AddToUnlockOffer[]
}

model UpsellRewardProduct {
  id         Int     @id @default(autoincrement())
  campaignId Int
  offerId    Int?
  shop       String?
  productId  String
  variantId  String?
  title      String?
  price      String?
  media      String?

  campaign UpsellCampaign @relation(fields: [campaignId], references: [id])

  AddToUnlockOffer AddToUnlockOffer[]
}

model UpsellFreeGiftProduct {
  id         Int     @id @default(autoincrement())
  campaignId Int
  offerId    Int?
  shop       String?
  productId  String
  variantId  String?
  title      String?
  price      String?
  media      String?

  campaign UpsellCampaign @relation(fields: [campaignId], references: [id])
}

model UpsellRewardCollection {
  id           Int     @id @default(autoincrement())
  campaignId   Int
  offerId      Int?
  shop         String?
  collectionid String
  title        String?
  price        String?
  media        String?

  campaign UpsellCampaign @relation(fields: [campaignId], references: [id])

  AddToUnlockOffer AddToUnlockOffer[]
}

model BuyMoreRule {
  id           Int     @id @default(autoincrement())
  campaignId   Int
  shop         String?
  productId    String
  quantity     Int
  discount     Float
  discountType String // 'percentage' | 'amount'

  campaign UpsellCampaign @relation(fields: [campaignId], references: [id])
}

model BogoRule {
  id         Int     @id @default(autoincrement())
  campaignId Int
  shop       String?
  buyQty     String
  getQty     String

  campaign UpsellCampaign @relation(fields: [campaignId], references: [id])
}

model BogoFreeItem {
  id         Int     @id @default(autoincrement())
  campaignId Int
  shop       String?
  productId  String
  variantId  String?
  title      String?
  price      String?
  media      String?

  campaign UpsellCampaign @relation(fields: [campaignId], references: [id])
}

model OrderBump {
  id               Int     @id @default(autoincrement())
  campaignId       Int
  shop             String?
  offerTitle       String?
  offerDescription String?
  preChecked       Boolean @default(false)
  iconUrl          String?
  onetickProducts  String?
  offerType        String?

  showConfetti     Boolean         @default(false)
  showLockedGoals  Boolean         @default(false)
  UpsellCampaign   UpsellCampaign? @relation(fields: [upsellCampaignId], references: [id])
  upsellCampaignId Int?
}

model CampaignTargetCountry {
  id         Int     @id @default(autoincrement())
  campaignId Int
  code       String? // e.g. "US", "CA"
  name       String?

  campaign UpsellCampaign @relation(fields: [campaignId], references: [id])
}

model CampaignExcludeCountry {
  id         Int     @id @default(autoincrement())
  campaignId Int
  code       String?
  name       String?

  campaign UpsellCampaign @relation(fields: [campaignId], references: [id])
}

model checkout_upsell {
  id           Int            @id @default(autoincrement())
  campaignId   Int
  productId    String?
  discountType String?
  discountCode String?
  campaign     UpsellCampaign @relation(fields: [campaignId], references: [id])
}

model PostPurchaseUpsell {
  id           Int            @id @default(autoincrement())
  campaignId   Int
  productId    String?
  discountType String?
  discountCode String?
  campaign     UpsellCampaign @relation(fields: [campaignId], references: [id])
}

enum CampaignStatus {
  ACTIVE
  INACTIVE
  DRAFT
}
