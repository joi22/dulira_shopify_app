<script>
  document.addEventListener('DOMContentLoaded', async function () {
    const App_Domain = 'https://vendor-sustainability-loan-goat.trycloudflare.com';
    const shop = Shopify.shop;
    const productId = '{{ product.id }}';
    const Api = `${App_Domain}/api/add_unlock/${productId}/${shop}`;

    let currentCampaignData = null; // Cache campaign data to avoid re-fetching on every update
    let currentCustomization = null;

    async function fetchCartData() {
      try {
        const response = await fetch('/cart.js', {
          method: 'GET',
          headers: { 'Content-Type': 'application/json' },
        });
        if (!response.ok) throw new Error('Failed to fetch cart data');
        return await response.json();
      } catch (err) {
        console.error('Error fetching cart data:', err);
        return null;
      }
    }

    function getOfferIcon(offer) {
      const icon = offer.badgeImageUrl;
      console.log(offer, 'this Progress bar == >><<');
      // Check if icon is a URL (image)
      if (icon && (icon.startsWith('http') || icon.startsWith('data:'))) {
        return `<img src="${icon}" alt="Offer Icon" style="width: 25px; position: relative; top: 5px;">`;
      }
      // Fallback to emojis based on rewardType
      if (offer.rewardType === 'discount') return '💰';
      if (offer.rewardType === 'shipping') return '🚚';
      if (offer.rewardType === 'gift') return '🎁';
      return '⭐';
    }

    function calculateProgress(offers, cartData) {
      const isQuantity = offers[0]?.goalType === 'quantity';
      const current = isQuantity ? cartData.item_count || 0 : parseFloat(cartData.total_price) / 100;

      const maxGoal = Math.max(
        ...offers.map((o) =>
          o.goalType === 'quantity' ? parseFloat(o.goalQuantity || 0) : parseFloat(o.goalAmount || 0)
        )
      );

      const progress = (current / maxGoal) * 100;
      return Math.min(progress, 100);
    }

    function renderRewardProducts(container, Gifts, cartData) {
      console.log(Gifts, '======== +>>> Gifts MAin ', cartData);
      if (!Gifts || !Gifts.length) return;

      // 🔎 Check if any gift product is already in cart
      const cartHasGift = cartData.items.some((item) =>
        Gifts.some((gift) => String(gift.variantId) === String(item.variant_id))
      );

      // Target cart drawer
      const pro_gift = document.querySelector('cart-drawer-items');
      if (!pro_gift) return;

      // ✅ Check if gift container already exists
      let gift_price = pro_gift.querySelector('.gift_box');
      if (!gift_price) {
        gift_price = document.createElement('div');
        gift_price.className = 'gift_box';
        pro_gift.appendChild(gift_price);
      }

      // ✅ If gift already in cart → hide immediately
      if (cartHasGift) {
        gift_price.style.display = 'none';
        gift_price.innerHTML = '';
        return;
      }

      // ✅ Otherwise show available gifts
      gift_price.style.display = 'block';

    let gridHtml = `
     <div class="gift-section">
  <div class="gift-section-title">🎁 Gift Items</div>
  <div class="gift-items-container">
`;

Gifts.forEach((prod) => {
  gridHtml += `
    <div class="gift-item">
      <div class="gift-item-image">
        <img src="${prod.media}" alt="${prod.title}">
      </div>
      <div class="gift-item-details">
        <div class="gift-item-title">
          ${prod.title} <span class="gift-badge">FREE</span>
        </div>
        <div class="gift-item-actions">
          <button class="add-to-cart-btn" data-variant="${prod.variantId}">
            Select
          </button>
        </div>
      </div>
      </div>
    </div>
  `;
});

gridHtml += `</div>`; // closes gift-items-container


      gift_price.innerHTML = gridHtml;

      // Attach add-to-cart handler
      gift_price.querySelectorAll('.add-to-cart-btn').forEach((btn) => {
        btn.addEventListener('click', async function () {
          const variantId = this.getAttribute('data-variant');
          this.disabled = true;
          this.innerText = 'Adding...';
          try {
            await fetch('/cart/add.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id: variantId, quantity: 1 }),
            });
            this.innerText = 'Added!';
            // ✅ Refresh cart immediately
            document.dispatchEvent(new CustomEvent('cart:updated'));
          } catch (err) {
            console.error('Error adding reward product:', err);
            this.disabled = false;
            this.innerText = 'Select';
          }
        });
      });
    }

    function renderSegmentProgressBar(container, offers, cartData, customization, Gifts) {
      const { barColors = {}, barRadius = 'round', barStyle = 'normal' } = customization || {};
      const { backgroundColor = '#e0e0e0', primaryColor = '#4CAF50', goalCompleteColor = '#FF9800' } = barColors;

      const borderRadius = barRadius === 'square' ? '0px' : '6px';
      const barHeight = barStyle === 'thin' ? '7px' : '12px';
      const topPosition = barStyle === 'thin' ? '42px' : '40px';

      // Calculate overall progress
      const progress = calculateProgress(offers, cartData);

      // Sort offers by goal value
      const sortedOffers = offers.sort((a, b) =>
        a.goalType === 'quantity'
          ? parseFloat(a.goalQuantity || 0) - parseFloat(b.goalQuantity || 0)
          : parseFloat(a.goalAmount || 0) - parseFloat(b.goalAmount || 0)
      );

      // Determine the active offer for the goal text
      let goalText = 'No offers available';
      if (sortedOffers.length > 0) {
        let activeOffer = null;
        for (const offer of sortedOffers) {
          const goalValue =
            offer.goalType === 'quantity' ? parseFloat(offer.goalQuantity || 0) : parseFloat(offer.goalAmount || 0);
          const currentValue =
            offer.goalType === 'quantity' ? cartData.item_count || 0 : parseFloat(cartData.total_price) / 100;
          if (currentValue < goalValue) {
            activeOffer = offer; // First uncompleted offer
            break;
          }
          activeOffer = offer; // Last completed offer
        }
        if (activeOffer) {
          console.log(activeOffer.goalTextAfter, '===== >>>> ');
          const isGoalReached =
            activeOffer.goalType === 'quantity'
              ? cartData.item_count >= parseFloat(activeOffer.goalQuantity || 0)
              : parseFloat(cartData.total_price) / 100 >= parseFloat(activeOffer.goalAmount || 0);
          const rewardDescription =
            activeOffer.rewardType === 'discount'
              ? `${activeOffer.discountCode}${activeOffer.discountType === 'percentage' ? '%' : '$'} Discount`
              : activeOffer.rewardType === 'shipping'
              ? 'Free Shipping'
              : 'Free Gift';
          const amountLeft =
            activeOffer.goalType === 'quantity'
              ? `${parseFloat(activeOffer.goalQuantity || 0) - (cartData.item_count || 0)} items`
              : `$${Math.max(
                  parseFloat(activeOffer.goalAmount || 0) - (parseFloat(cartData.total_price) / 100 || 0),
                  0
                ).toFixed(2)}`;
          const goal =
            activeOffer.goalType === 'quantity'
              ? `${activeOffer.goalQuantity || 0} items`
              : `$${activeOffer.goalAmount || 0}`;
          goalText = isGoalReached ? activeOffer.goalTextAfter : activeOffer.goalTextBefore;
        }
      }

      // Clear previous content to avoid duplicates
      container.innerHTML = '';
      console.log(goalText, 'main +++ ==== <<< ');
      // Create or update the goal text element
      const goalTextElement = document.createElement('div');
      goalTextElement.className = 'goal-text';
      goalTextElement.innerText = goalText;
      container.appendChild(goalTextElement);

      // Build progress bar HTML
      let html = `<div class="multi_step_progress">`;
      html += `<div class="progress_line_bg" style="background:${backgroundColor}; border-radius:${borderRadius}; height:${barHeight}; top:${topPosition};"></div>`;
      html += `<div class="progress_line_fill" style="width:${progress}%; background:${
        progress >= 100 ? goalCompleteColor : primaryColor
      }; border-radius:${borderRadius}; height:${barHeight}; top:${topPosition};"></div>`;

      const goals = sortedOffers.map((o) =>
        o.goalType === 'quantity' ? parseFloat(o.goalQuantity || 0) : parseFloat(o.goalAmount || 0)
      );
      const minGoal = Math.min(...goals);
      const maxGoal = Math.max(...goals);

      sortedOffers.forEach((offer, index) => {
        const isQuantity = offer.goalType === 'quantity';
        const goal = isQuantity ? parseFloat(offer.goalQuantity || 0) : parseFloat(offer.goalAmount || 0);
        const current = isQuantity ? cartData.item_count || 0 : parseFloat(cartData.total_price) / 100;
        const unlocked = current >= goal;

        const circleStyle = `
            background:${unlocked ? goalCompleteColor : '#ddd'}; 
            color:${unlocked ? '#fff' : '#000'};`;

        let leftPercent = ((goal - minGoal) / (maxGoal - minGoal)) * 100;
        if (index === 0) leftPercent = 8;
        if (index === sortedOffers.length - 1) leftPercent = 100;

        html += `
            <div class="progress_step" data-goal="${goal}" style="left: ${(goal / maxGoal) * 100}%;">
              <div class="circle" style="${circleStyle}">${getOfferIcon(offer)}</div>
              <div class="step_goal">${goal}</div>
            </div>`;

        if (unlocked && (offer.rewardType === 'gift' || offer.rewardType === 'product')) {
          if (Gifts && Gifts.length) {
            renderRewardProducts(container, Gifts, cartData);
          }
        }
      });

      html += `</div>`; // Close progress bar
      container.innerHTML += html;
      // const announcement_bar = document.getElementById("announcement-bars");
      // announcement_bar.innerHTML =html;
    }

    async function updateProgressBar() {
      try {
        const cartData = await fetchCartData();
        if (!cartData) return;

        // Use cached campaign data if available
        if (!currentCampaignData) {
          const response = await fetch(Api);
          if (!response.ok) throw new Error('Failed to fetch upsell data');
          const data = await response.json();

          const upsellTriggers = Array.isArray(data.upsellTriggerProduct) ? data.upsellTriggerProduct : [];
          if (!upsellTriggers.length) return;

          const latestCampaign = upsellTriggers
            .map((p) => p.campaign)
            .filter(Boolean)
            .pop();
          if (!latestCampaign) return;

          currentCampaignData = latestCampaign;
          currentCustomization = latestCampaign.customization || [];
        }

        const Offers = currentCampaignData.offers || [];
        const customization = currentCustomization;
        const Gifts = currentCampaignData.rewardProducts || [];
        const drawer = document.querySelector('cart-drawer') || document.querySelector('.cart-drawer');
        if (!drawer) return;

        let header = drawer.querySelector('.drawer__header');
        if (!header) {
          header = document.createElement('div');
          header.className = 'drawer__header upsell-header';
          drawer.insertBefore(header, drawer.firstChild);
        }

        // const existingUpsell = header.querySelector('.upsell-container');
        // if (existingUpsell) existingUpsell.remove();
        let upsellContainer = header.querySelector('.upsell-container');
        if (!upsellContainer) {
          upsellContainer = document.createElement('div');
          upsellContainer.className = 'upsell-container';
          header.appendChild(upsellContainer);
        }

        if (currentCampaignData.type === 'add_to_unlock') {
          setTimeout(() => {
            upsellContainer.scrollIntoView({ behavior: 'smooth' });
            renderSegmentProgressBar(upsellContainer, Offers, cartData, customization, Gifts);
          }, 3000);
        }
      } catch (err) {
        console.error('Error updating progress bar:', err);
      }
    }

    function waitForDrawer(callback) {
      const drawer = document.querySelector('cart-drawer') || document.querySelector('.cart-drawer');
      if (drawer) {
        callback();
        return;
      }
      const observer = new MutationObserver(() => {
        if (document.querySelector('cart-drawer') || document.querySelector('.cart-drawer')) {
          observer.disconnect();
          callback();
        }
      });
      observer.observe(document.body, { childList: true, subtree: true });
    }

    // Setup quantity change listener for real-time updates (increase/decrease)
    // Listen to Shopify cart updates + quantity changes
    function setupQuantityListener() {
      const debouncedUpdate = debounce(updateProgressBar, 300);

      // Listen to manual typing in input
      document.addEventListener(
        'input',
        function (event) {
          if (event.target && event.target.classList.contains('quantity__input')) {
            debouncedUpdate();
          }
        },
        true
      );

      // Listen to plus/minus button clicks (they dispatch "change" on input after AJAX)
      document.addEventListener(
        'change',
        function (event) {
          if (event.target && event.target.classList.contains('quantity__input')) {
            debouncedUpdate();
          }
        },
        true
      );

      // Listen to Shopify drawer/cart events (when AJAX updates the whole drawer)
      document.addEventListener('cart:updated', updateProgressBar);
      document.addEventListener('cart-drawer:updated', updateProgressBar);
    }

    // Debounce utility function to limit frequent calls
    function debounce(func, wait) {
      let timeout;
      return function executedFunction(...args) {
        const later = () => {
          clearTimeout(timeout);
          func(...args);
        };
        clearTimeout(timeout);
        timeout = setTimeout(later, wait);
      };
    }

    waitForDrawer(() => {
      updateProgressBar(); // Initial render
      document.addEventListener('cart-drawer:open', updateProgressBar);
      setupQuantityListener(); // Initialize the listener once drawer is ready

      setInterval(updateProgressBar, 1000);
    });
  });
</script>

