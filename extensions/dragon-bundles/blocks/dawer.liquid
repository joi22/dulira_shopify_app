<script>
  document.addEventListener('DOMContentLoaded', async function () {
    // Configuration
    const App_Domain = window.App_Domain || 'https://facilities-generates-thing-opposed.trycloudflare.com';
    const shop = window.Shopify?.shop || document.querySelector('meta[name="shopify-shop-domain"]')?.content;
    if (!shop) {
      console.error('Shopify shop domain not found');
      return;
    }

    // Normalize variant ID
    function normalizeVariantId(gid) {
      return gid?.includes('gid://') ? gid.split('/').pop() : gid?.toString() || null;
    }

    // Check if variant is a reward
    function isRewardVariant(variantId, campaign) {
      return (campaign.rewardProducts || []).some((p) => normalizeVariantId(p?.variantId) === variantId?.toString());
    }

    // Sanitize HTML to prevent XSS
    function sanitizeHTML(str) {
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }

    // Add to cart function
    async function addToCart(variantId, quantity = 1) {
      try {
        const cart = await fetch('/cart.js').then((res) => res.json());
        const variantIds = cart.items.map((item) => item.variant_id?.toString());

        if (variantIds.includes(variantId.toString())) {
          alert('🎁 This reward is already in your cart.');
          return;
        }

        const response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: JSON.stringify({
            id: variantId, // 👈 correct key for Shopify
            quantity: parseInt(quantity), // 👈 must be number
            sections: ['cart-drawer', 'cart-icon-bubble'],
            sections_url: '/products/the-collection-snowboard-hydrogen',
          }),
        });

        if (!response.ok) throw new Error(`Cart add failed: ${response.status}`);
        await response.json();

        document.dispatchEvent(new CustomEvent('cart:updated'));
      } catch (err) {
        console.error('Add To Cart error:', err);
        alert('❌ Could not add item to cart.');
      }
    }

    // Create progress bar
    async function createProgressBar({
      campaign,
      goalType,
      goalValue,
      cartItems,
      rewardVariantIds = [],
      barColors = {},
      barRadius,
      preGoalText = '',
      GoalText = '',
    }) {
      const nonRewardItems = cartItems.filter((item) => !rewardVariantIds.includes(item.variant_id.toString()));
      const totalItems = nonRewardItems.reduce((sum, item) => sum + (item.quantity || 0), 0);
      const cartValue = nonRewardItems.reduce((sum, item) => sum + item.line_price, 0) / 100;

      const percentage = Math.min(
        100,
        goalType === 'amount_cart' ? (cartValue / goalValue) * 100 : (totalItems / goalValue) * 100
      );

      const remaining =
        goalType === 'amount_cart' ? Math.max(0, goalValue - cartValue) : Math.max(0, goalValue - totalItems);
      const goalMet = remaining <= 0;

      const fillColor = goalMet ? barColors.goalComplete || '#4caf50' : barColors.primary || '#4caf50';
      const backgroundColor = barColors.background || '#e0e0e0';
      const radius = barRadius || 0;

      const progressLabel = goalMet
        ? sanitizeHTML(GoalText || '🎉 Goal Reached!')
        : `👉 Add More ${
            goalType === 'amount_cart'
              ? `${sanitizeHTML(remaining.toFixed(0))} ${sanitizeHTML(campaign.currency || 'MAD')}`
              : `${sanitizeHTML(remaining.toString())} item(s)`
          } to unlock`;

      const container = document.createElement('div');
      container.className = 'progress_card';
      container.style = 'width: 100%';

      const label = document.createElement('p');
      label.style.cssText = 'font-weight:600; margin-bottom:10px;';
      label.innerHTML = progressLabel;

      const progressBar = document.createElement('div');
      progressBar.style.cssText = `
      position: relative;
      width: 100%;
      height: 16px;
      background: ${backgroundColor};
      border-radius: ${radius}px;
      overflow: hidden;
      margin-bottom: 10px;
        `;

      const barFill = document.createElement('div');
      barFill.style.cssText = `
      height: 100%;
      width: ${percentage}%;
      background: ${fillColor};
      border-radius: ${radius}px;
      transition: width 0.4s ease;
        `;

      const percentageText = document.createElement('span');
      percentageText.style.cssText = `
      position: absolute;
      right: 10px;
      top: -22px;
      font-size: 12px;
      font-weight: bold;
      color: #333;
        `;
      percentageText.textContent = `${Math.round(percentage)}%`;

      const shippingText = document.createElement('div');
      shippingText.className = 'free_shipping';
      shippingText.style.cssText = 'margin-top:6px; font-style:italic; color:#666;';
      shippingText.textContent = `🚚 ${sanitizeHTML(preGoalText || '')}`;

      progressBar.appendChild(barFill);
      progressBar.appendChild(percentageText);
      container.appendChild(label);
      container.appendChild(progressBar);
      container.appendChild(shippingText);

      return container;
    }
    function BMSMOffer(campaign, cartItems, addToCart) {
      const nonRewardItems = cartItems.filter(
        (item) => !campaign.rewardProducts.some((p) => normalizeVariantId(p.variantId) === item.variant_id?.toString())
      );

      const totalItems = nonRewardItems.reduce((sum, item) => sum + (item.quantity || 0), 0);

      const steps = (campaign.buyMoreRules || []).map((step) => ({
        quantity: parseInt(step.quantity, 10) || 0,
        discountType: step.discountType || 'percentage',
        discountValue: step.discount ? parseFloat(step.discount) : 0, // fallback to 0 instead of NaN
      }));
      steps.sort((a, b) => a.quantity - b.quantity);

      let currentStep = null;
      let nextStep = null;
      for (let i = 0; i < steps.length; i++) {
        if (totalItems >= steps[i].quantity) currentStep = steps[i];
        else {
          nextStep = steps[i];
          break;
        }
      }

      // Remove old card if exists
      const oldCard = document.querySelector('.bmsm-card');
      if (oldCard) oldCard.remove();

      const card = document.createElement('div');
      card.className = 'bmsm-card';
      card.style.cssText = `
          padding: 12px;
          border-radius: 10px;
          background-color: #eef0ff;
          margin: 15px 0;
          border: 2px solid #5f59f7;
          font-family: Arial, sans-serif;
        `;

      const title = document.createElement('h4');
      title.textContent = campaign.title || 'Buy More Save More';
      title.style.cssText = 'margin:0 0 8px 0; color:#333; font-size:15px; font-weight:600; text-align:center;';
      card.appendChild(title);

      // --- Progress Bar ---
      const progressContainer = document.createElement('div');
      progressContainer.style.cssText =
        'display:flex; justify-content:space-between; align-items:center; margin:10px 0;';

      steps.forEach((step, index) => {
        const stepEl = document.createElement('div');
        stepEl.style.cssText = `
            flex:1; 
            text-align:center; 
            font-size:12px; 
            padding:5px; 
            border-radius:6px; 
            margin:0 3px;
          `;
        stepEl.textContent =
          `Pick ${step.quantity} - ` +
          (step.discountType === 'percentage'
            ? `Save ${step.discountValue}%`
            : `Save ${step.discountValue.toFixed(2)} ${sanitizeHTML(campaign.currency || '$')}`);
        progressContainer.appendChild(stepEl);
      });

      card.appendChild(progressContainer);

      // --- Current Step Message ---
      if (currentStep && currentStep.discountType === 'percentage') {
        const discountAmount = cart.total_price * (currentStep.discountValue / 100);
        const discountedTotal = (cart.total_price - discountAmount) / 100;
        const discountLine = document.createElement('p');
        discountLine.style.cssText = 'margin:5px 0; font-size:13px; font-weight:bold; color:#333;';
        discountLine.textContent = `Subtotal after discount: ${discountedTotal.toFixed(2)} ${campaign.currency || '$'}`;
        card.appendChild(discountLine);
      }
      console.log(nextStep, '-=============>>>');
      // --- Next Step Message ---
      if (nextStep) {
        const nextOffer = document.createElement('p');
        nextOffer.style.cssText = 'margin:8px 0; color:#e67e22; font-size:13px; text-align:center;';
        nextOffer.innerHTML = `👉 Add ${sanitizeHTML(
          (nextStep.quantity - totalItems).toString()
        )} more item(s) to unlock ${
          nextStep.discountType === 'percentage'
            ? `${nextStep.discountValue}%`
            : `${nextStep.discountValue.toFixed(2)} ${sanitizeHTML(campaign.currency || '$')}`
        } discount!`;
        card.appendChild(nextOffer);
      }

      return card;
    }

