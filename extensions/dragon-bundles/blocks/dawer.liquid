  // --- MAIN LOADER ---
  async function renderUpsellContent() {
    try {
      const response = await fetch(Api);
      if (!response.ok) throw new Error('Failed to fetch data');
      const data = await response.json();
      const upsellTriggers = Array.isArray(data.upsellTriggerProduct) ? data.upsellTriggerProduct : [];
      if (upsellTriggers.length > 0) {
        const latestCampaign = upsellTriggers.map(p => p.campaign).filter(Boolean).pop();
        if (latestCampaign) {
          const placement = JSON.parse(latestCampaign.placement || '[]');
          const Offers = latestCampaign.offers || [];
          const gift_products = latestCampaign.rewardProducts || [];
          const triggerProducts = latestCampaign.triggerProducts || [];

          const drawer = document.querySelector('cart-drawer') || document.querySelector('.cart-drawer');
          if (!drawer) return;

          let header = drawer.querySelector('.drawer__header');
          if (!header) {
            header = document.createElement('div');
            header.className = 'drawer__header upsell-header';
            drawer.insertBefore(header, drawer.firstChild);
          }

          const existingUpsell = header.querySelector('.upsell-container');
          if (existingUpsell) existingUpsell.remove();

          const upsellContainer = document.createElement('div');
          upsellContainer.className = 'upsell-container';
          header.appendChild(upsellContainer);

          if (latestCampaign.type === 'add_to_unlock' && placement.includes('Page')) {
            for (const offer of Offers) {
              await renderOffer(latestCampaign, offer, gift_products, triggerProducts, upsellContainer);
              await progressBardynamic(campaign, offer ,upsellContainer );
            }
          }
        }
      }
    } catch (err) {
      console.error('❌ Error loading upsell:', err);
      const drawer = document.querySelector('cart-drawer') || document.querySelector('.cart-drawer');
      if (drawer) {
        drawer.querySelector('.upsell-container')?.insertAdjacentHTML('beforeend', '<p style="color: red;">Failed to load offers. Please try again later.</p>');
      }
    }
  }

  // --- WAIT FOR DRAWER ---
  function waitForDrawer(callback) {
    const drawer = document.querySelector('cart-drawer') || document.querySelector('.cart-drawer');
    if (drawer) {
      callback();
      return;
    }

    const observer = new MutationObserver(() => {
      if (document.querySelector('cart-drawer') || document.querySelector('.cart-drawer')) {
        observer.disconnect();
        callback();
      }
    });

    observer.observe(document.body, { childList: true, subtree: true });
  }

  waitForDrawer(() => {
    renderUpsellContent();
    document.addEventListener('cart:updated', renderUpsellContent);
    document.addEventListener('cart-drawer:open', renderUpsellContent);
  });
});
