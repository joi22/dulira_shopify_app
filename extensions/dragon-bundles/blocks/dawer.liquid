<script>
  document.addEventListener('DOMContentLoaded', async function () {
    const App_Domain = 'https://accomplish-steal-canal-selling.trycloudflare.com';
    const shop = Shopify.shop;

    function normalizeVariantId(gid) {
      return gid?.includes('gid://') ? gid.split('/').pop() : gid?.toString() || null;
    }

    function isRewardVariant(variantId, campaign) {
      return (campaign.rewardProducts || []).some((p) => normalizeVariantId(p?.variantId) === variantId?.toString());
    }

    async function addToCart(productId, quantity) {
      try {
        const cart = await fetch('/cart.js').then((res) => res.json());
        const variantIds = cart.items.map((item) => item.variant_id?.toString());
        console.log(productId, quantity, '=============>>>><<<<<>>>>>');
        if (variantIds.includes(productId.toString())) {
          alert('🎁 This reward is already in your cart.');
          return;
        }

        const response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: JSON.stringify({
            id: productId,
            quantity: 1,
          }),
        });

        if (!response.ok) throw new Error(`Cart add failed: ${response.status}`);
        await response.json();
        document.dispatchEvent(new CustomEvent('cart:updated'));
      } catch (err) {
        console.error('Add To Cart error:', err);
        alert('❌ Could not add item to cart.');
      }
    }

    async function createProgressBar({
      goalType,
      goalValue,
      cartItems,
      rewardVariantIds = [],
      barColors = {},
      barRadius,
      preGoalText = '',
      GoalText = '',
    }) {
      const nonRewardItems = cartItems.filter((item) => rewardVariantIds.includes(item.variant_id.toString()));
      const totalItems = nonRewardItems.reduce((sum, item) => sum + (item.quantity || 0), 0);
      let cartValue = nonRewardItems.reduce((sum, item) => sum + item.line_price, 0) / 100;
      console.log(nonRewardItems, '============>>><<<< >>>>');
      const percentage = Math.min(
        100,
        goalType === 'amount_cart' ? (cartValue / goalValue) * 100 : (totalItems / goalValue) * 100
      );

      const remaining =
        goalType === 'amount_cart' ? Math.max(0, goalValue - cartValue) : Math.max(0, goalValue - totalItems);

      const goalMet = remaining <= 0;
      const fillColor = goalMet ? barColors.goalComplete || '#4caf50' : barColors.primary || '#4caf50';
      const backgroundColor = barColors.background || '#e0e0e0';
      const radius = barRadius || 0;

      const progressLabel = goalMet
        ? GoalText || '🎉 Goal Reached!'
        : `👉 Add More ${
            goalType === 'amount_cart' ? remaining.toFixed(0) + ' MAD' : remaining + ' item(s)'
          } to unlock`;

      const container = document.createElement('div');
      container.className = 'progress_card';
      container.style = 'width: 100%';
      container.innerHTML = `
      <p style="font-weight:600; margin-bottom:10px;">${progressLabel}</p>
      <div style="position:relative; width:100%; height:16px; background:${backgroundColor}; border-radius:${radius}px; overflow:hidden; margin-bottom:10px;">
        <div style="height:100%; width:${percentage}%; background:${fillColor}; border-radius:${radius}px; transition:width 0.4s ease;"></div>
        <span style="position:absolute; right:10px; top:-22px; font-size:12px; font-weight:bold; color:#333;">${Math.round(
          percentage
        )}%</span>
      </div>
      <div class="free_shipping" style="margin-top:6px; font-style:italic; color:#666;">🚚 ${preGoalText || ''}</div>
    `;
      return container;
    }

    async function renderUpsellContent() {
      try {
        const cart = await fetch('/cart.js').then((res) => res.json());
        const cartItems = cart.items || [];
        const productIds = cartItems.map((item) => item.product_id?.toString()).filter(Boolean);
        const variantIds = cartItems.map((item) => item.variant_id?.toString()).filter(Boolean);

        const Api = `${App_Domain}/api/add_unlock/${productIds.length > 0 ? productIds.join(',') : 'default'}/${shop}`;
        const res = await fetch(Api);
        if (!res.ok) return;

        const data = await res.json();
        const triggers = Array.isArray(data.upsellTriggerProduct)
          ? data.upsellTriggerProduct
          : [data.upsellTriggerProduct];

        const headerContainer = document.querySelector('.drawer__header');
        const footerContainer = document.querySelector('.drawer__footer');
        const cartContainer = document.querySelector('cart-drawer-items');
        if (!headerContainer || !footerContainer || !cartContainer) return;

        // Clear existing upsell content
        document
          .querySelectorAll('.gift_campaign_container, .discount_campaign_container')
          .forEach((el) => el.remove());
        document.querySelector('.progress_card')?.remove();

        let upsellFooter = document.querySelector('.main_upsell');
        if (!upsellFooter) {
          upsellFooter = document.createElement('div');
          upsellFooter.className = 'main_upsell';
          footerContainer.insertBefore(upsellFooter, footerContainer.firstChild);
        } else {
          upsellFooter.innerHTML = '';
        }

        let anyUpsell = false;
        const campaigns = [];

        // Calculate non-reward items for all campaigns
        const nonRewardItems = cartItems.filter((item) => {
          return triggers.some((trigger) => isRewardVariant(item.variant_id?.toString(), trigger.campaign));
        });
        const totalItems = nonRewardItems.reduce((sum, item) => sum + (item.quantity || 0), 0);
        const cartValue = nonRewardItems.reduce((sum, item) => sum + item.line_price, 0) / 100;

        for (const trigger of triggers) {
          const campaign = trigger?.campaign;
          if (!campaign) continue;

          const goalType = campaign.goalType || (campaign.goalquantity ? 'quantity' : 'amount_cart');
          const goalValue = goalType === 'quantity' ? parseInt(campaign.goalquantity) : parseFloat(campaign.goalAmount);
          const rewardVariantIds = (campaign.rewardProducts || [])
            .map((p) => normalizeVariantId(p?.variantId))
            .filter(Boolean);

          campaigns.push({ campaign, goalType, goalValue, rewardVariantIds });
        }

        campaigns.sort((a, b) => {
          const aValue = a.goalType === 'amount_cart' ? a.goalValue : a.goalValue * 100;
          const bValue = b.goalType === 'amount_cart' ? b.goalValue : b.goalValue * 100;
          return aValue - bValue;
        });

        let selectedCampaign = null;
        for (const { campaign, goalType, goalValue, rewardVariantIds } of campaigns) {
          const remaining =
            goalType === 'amount_cart' ? Math.max(0, goalValue - cartValue) : Math.max(0, goalValue - totalItems);

          if (remaining > 0 || !selectedCampaign) {
            selectedCampaign = { campaign, goalType, goalValue, rewardVariantIds };
          }
          if (remaining > 0) break;
        }

        if (selectedCampaign) {
          let barColors;
          try {
            barColors = JSON.parse(selectedCampaign.campaign.barColors || '{}');
          } catch {
            barColors = { primary: '#4caf50', background: '#e0e0e0', goalComplete: '#4caf50' };
          }

          const radius =
            selectedCampaign.campaign.barRadius === 'rounded' ? 5 : parseInt(selectedCampaign.campaign.barRadius) || 0;

          const progressBar = await createProgressBar({
            goalType: selectedCampaign.goalType,
            goalValue: selectedCampaign.goalValue,
            cartItems,
            rewardVariantIds: selectedCampaign.rewardVariantIds,
            barColors,
            barRadius: radius,
            preGoalText: selectedCampaign.campaign.preGoalText,
            GoalText: selectedCampaign.campaign.goalText,
          });

          headerContainer.insertBefore(progressBar, headerContainer.firstChild);
        }

        for (const { campaign, rewardVariantIds, goalType, goalValue } of campaigns) {
          const UpsellFreeGiftProduct = campaign.UpsellFreeGiftProduct || [];
          const triggerProducts = campaign.triggerProducts || [];
          const rewardType = campaign.rewardType;
          const remaining =
            goalType === 'amount_cart' ? Math.max(0, goalValue - cartValue) : Math.max(0, goalValue - totalItems);
          const goalMet = remaining <= 0;

          if (rewardType === 'gift') {
            anyUpsell = true;
            const campaignContainer = document.createElement('div');
            campaignContainer.className = 'gift_campaign_container';
            campaignContainer.style.cssText =
              'margin-bottom:20px; padding:15px; border:1px solid #e0e0e0; border-radius:8px;';

            const title = document.createElement('h4');
            title.textContent = campaign.title || 'Special Offer';
            title.style.cssText = 'margin:0 0 10px 0; color:#333; font-size:16px; font-weight:600;';
            campaignContainer.appendChild(title);

            const status = document.createElement('p');
            status.textContent = goalMet
              ? '🎉 Offer Unlocked! Select a free gift below.'
              : `Add ${
                  goalType === 'amount_cart' ? remaining.toFixed(0) + ' MAD' : remaining + ' item(s)'
                } to unlock this offer`;
            status.style.cssText = `margin:0 0 10px 0; color:${goalMet ? '#4caf50' : '#e74c3c'}; font-size:14px;`;
            campaignContainer.appendChild(status);

            const form = document.createElement('div');
            form.className = `gift_reward_form gift_reward_form_${campaign.id}`;
            let selectedVariantId = null;

            UpsellFreeGiftProduct.forEach((product, index) => {
              const variantId = normalizeVariantId(product.variantId);
              const disabled = variantIds.includes(variantId) || !goalMet;

              const inputId = `gift-option-${campaign.id}-${index}`;

              const card = document.createElement('div');
              card.className = 'product_card_dwer';
              card.innerHTML = `
              <label style="display:flex; align-items:center; gap:10px; cursor:${
                disabled ? 'not-allowed' : 'pointer'
              }; opacity:${disabled ? 0.5 : 1}">
                <input type="radio" name="giftReward_${
                  campaign.id
                }" id="${inputId}" value="${variantId}" style="transform:scale(1.3);" ${disabled ? 'disabled' : ''} />
                <img src="${product.media || 'https://via.placeholder.com/50'}" alt="${
                product.title
              }" width="50" height="60" style="object-fit:cover;" />
                <div style="flex:1;"><strong>${product.title}</strong><br/><span>FREE Gift</span></div>
              </label>`;
              const radio = card.querySelector('input[type="radio"]');
              if (!disabled) {
                radio.addEventListener('change', () => {
                  selectedVariantId = radio.value;
                  console.log('Selected Variant ID:', selectedVariantId);
                });
              }
              form.appendChild(card);
            });

            const addGiftButton = document.createElement('button');
            addGiftButton.textContent = goalMet ? '🎁 Add Gift to Cart' : '🔒 Offer Locked';
            addGiftButton.disabled = !goalMet;
            addGiftButton.style.cssText = `margin-top:12px; padding:10px 16px; font-weight:bold; background:${
              goalMet ? '#4caf50' : '#ccc'
            }; color:white; border:none; border-radius:4px; cursor:${goalMet ? 'pointer' : 'not-allowed'};`;
            addGiftButton.addEventListener('click', async () => {
              if (!selectedVariantId) return alert('Please select a gift product.');
              await addToCart(selectedVariantId, 1);
            });

            form.appendChild(addGiftButton);
            campaignContainer.appendChild(form);
            cartContainer.appendChild(campaignContainer);
          }

          if (rewardType === 'discount' && triggerProducts.length > 0) {
            anyUpsell = true;
            const campaignContainer = document.createElement('div');
            campaignContainer.className = 'discount_campaign_container';
            campaignContainer.style.cssText =
              'margin-bottom:20px; padding:15px; border:1px solid #e0e0e0; border-radius:8px;';

            triggerProducts.forEach((product) => {
              const price = parseFloat(product.price || 0);
              const variantId = normalizeVariantId(product?.variantId);
              if (!variantId) return;

              const card = document.createElement('div');
              card.className = 'product_card_dwer';
              card.innerHTML = `
              <div style="display:flex; gap:10px; align-items:center;">
                <img src="${product.media || 'https://via.placeholder.com/50'}" alt="${
                product.title || 'Product'
              }" width="50" height="60" style="object-fit:cover;" />
                <div style="flex:1;">
                  <strong>${product.title || 'Unnamed Product'}</strong><br/>
                  <span>${price.toFixed(2)} MAD</span>
                </div>
                <button data-variant="${variantId}"  style="padding:8px 12px; background:'#4caf50'
              }; color:white; border:none; border-radius:4px; cursor: 'pointer' ">Add To Cart</button>
              </div>
            `;

              card.querySelector('button').addEventListener('click', async () => {
                await addToCart(variantId, 1);
              });

              campaignContainer.appendChild(card);
            });

            footerContainer.insertBefore(campaignContainer, footerContainer.firstChild);
          }
          if (campaign.type === 'buy_more_save_more') {
            anyUpsell = true;

            // Hide old card if exists
            const oldCard = document.querySelector('.progress_card');
            if (oldCard) oldCard.style.display = 'none';

            const card = document.createElement('div');
            card.className = 'upsell-card bmsm-card';
            card.style.cssText = `
                padding: 16px;
                border-radius: 12px;
                background-color: #eef0ff;
                margin: 20px 0;
                border: 2px solid #5f59f7;
                font-family: Arial, sans-serif;
                text-align: center;
              `;

            // Loop through reward products
            (campaign.rewardProducts || []).forEach((rewardProduct) => {
              const rewardTitle = rewardProduct?.title || 'Reward Item';

              const savingsBanner = document.createElement('div');
              savingsBanner.textContent = rewardTitle;
                        savingsBanner.style.cssText = `
                background-color: #6d00c7;
                color: white;
                padding: 8px 12px;
                border-radius: 6px;
                font-size: 14px;
                font-weight: 600;
                margin-bottom: 15px;
                text-align: center;
              `;
              card.appendChild(savingsBanner);

              const tiersRow = document.createElement('div');
              tiersRow.style.cssText = `
                display: flex;
                flex-wrap: wrap;
                justify-content: center;
                gap: 10px;
                margin-top: 8px;`
              const buyMoreRules = campaign.buyMoreRules || [];
              buyMoreRules.forEach((rule) => {
                const tier = document.createElement('div');
                const discountText =
                  rule.discountType === 'percentage'
                    ? `Save ${rule.discount}%`
                    : `Save ${campaign.currency || '$'}${rule.discount} each`;

                tier.textContent = `Pick ${rule.quantity} items – ${discountText}`;
                tier.style.cssText = `
                  font-size: 11px;
                  padding: 8px 12px;
                  background-color: #fff;
                  border: 1px solid #ccc;
                  border-radius: 8px;
                  min-width: 120px;
                  text-align: center;
                   `;
                tiersRow.appendChild(tier);
              });

              card.appendChild(tiersRow);
            });

            // Insert card into header
            headerContainer.appendChild(card);
          }
        }

        if (!anyUpsell && upsellFooter) upsellFooter.remove();
      } catch (err) {
        console.error('Error rendering upsell:', err);
      }
     }

    await renderUpsellContent();

    document.addEventListener('cart:updated', renderUpsellContent);

    let lastCart = await fetch('/cart.js').then((res) => res.json());
    setInterval(async () => {
      try {
        const newCart = await fetch('/cart.js').then((res) => res.json());
        if (JSON.stringify(newCart) !== JSON.stringify(lastCart)) {
          lastCart = newCart;
          document.dispatchEvent(new CustomEvent('cart:updated'));
        }
      } catch (error) {
        console.error('Cart polling error:', error);
      }
    }, 2000); 
  });
</script>

<style>
  .drawer__header {
    flex-direction: column;
  }
  .product_card_dwer {
    border: 0.2px solid gray;
    padding: 5px;
    font-size: 13px;
    margin: 5px;
    border-radius: 7px;
  }
  .product_card_dwer button {
    background: #4caf50;
    color: white;
    border: none;
    padding: 8px 16px;
    border-radius: 4px;
    cursor: pointer;
  }
  .product_card_dwer button:disabled {
    background: #ccc;
    cursor: not-allowed;
  }
  .product_card_dwer .product_upsell {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
  }
</style>

{% schema %}
{
  "name": "DragOn Bundales Upsell",
  "target": "body",
  "settings": []
}
{% endschema %}
