        border-radius: 12px;
        background-color: #f9f9f9;
        margin: 15px 0;
        border: 1px solid #e0e0e0;
        font-family: 'Helvetica Neue', Arial, sans-serif;
        `;

      // Header section
      const header = document.createElement('div');
      header.style.display = 'flex';
      header.style.justifyContent = 'space-between';
      header.style.alignItems = 'center';
      header.style.marginBottom = '15px';

      const title = document.createElement('h3');
      title.textContent = 'Add to unlock free shipping';
      title.style.margin = '0';
      title.style.fontSize = '18px';
      title.style.color = '#333';

      header.appendChild(title);
      card.appendChild(header);

      // Progress bar
      const percentage = goalValue > 0 ? Math.min(100, ((goalValue - remaining) / goalValue) * 100) : 100;

      const progressContainer = document.createElement('div');
      progressContainer.style.margin = '10px 0';

      const progressText = document.createElement('div');
      progressText.style.marginBottom = '8px';
      progressText.style.fontSize = '14px';
      progressText.style.color = '#555';

      if (goalMet) {
        progressText.textContent = "You've unlocked free shipping!";
        progressText.style.color = '#4CAF50';
        progressText.style.fontWeight = '600';
      } else {
        progressText.textContent = `Add €${remaining.toFixed(2)} more to unlock free shipping!`;
      }

      const progressBarWrapper = document.createElement('div');
      progressBarWrapper.style.width = '100%';
      progressBarWrapper.style.height = '8px';
      progressBarWrapper.style.backgroundColor = '#e0e0e0';
      progressBarWrapper.style.borderRadius = '4px';
      progressBarWrapper.style.overflow = 'hidden';

      const progressBar = document.createElement('div');
      progressBar.style.height = '100%';
      progressBar.style.width = `${percentage}%`;
      progressBar.style.backgroundColor = '#4CAF50';
      progressBar.style.borderRadius = '4px';
      progressBar.style.transition = 'width 0.5s ease';

      progressBarWrapper.appendChild(progressBar);
      progressContainer.appendChild(progressText);
      progressContainer.appendChild(progressBarWrapper);
      card.appendChild(progressContainer);

      // Products grid
      const productsGrid = document.createElement('div');
      productsGrid.style.display = 'grid';
      productsGrid.style.gridTemplateColumns = 'repeat(4, 1fr)';
      productsGrid.style.gap = '10px';
      productsGrid.style.margin = '15px 0';

      // Sample products data - replace with your actual products
      {% comment %} const products = rewardProducts.forEach((item)=>{

      }); {% endcomment %}
      console.log(rewardProducts,"teh function ")

      rewardProducts.forEach((product) => {
        const productCard = document.createElement('div');
        productCard.style.textAlign = 'center';

        // Product image placeholder
        const image = document.createElement('div');
        image.style.height = '80px';
        image.style.backgroundColor = '#eee';
        image.style.borderRadius = '4px';
        image.style.marginBottom = '8px';
        // In a real implementation, you would use an actual image:
        image.style.backgroundImage = `url(${product.media})`;
        image.style.backgroundSize = 'cover';

        // Product name
        const name = document.createElement('div');
        name.textContent = product.title;
        name.style.fontSize = '14px';
        name.style.fontWeight = '500';
        name.style.marginBottom = '4px';

        // Product price
        const price = document.createElement('div');
        price.textContent = `€${product.price}`;
        price.style.fontSize = '14px';
        price.style.color = '#666';

        // Add to cart button
        const button = document.createElement('button');
        button.textContent = 'ADD';
        button.style.cssText = `
            margin-top: 8px;
            padding: 6px 12px;
            background-color: #4CAF50;
            color: white;
            border: none;
            border-radius: 4px;
            font-size: 12px;
            cursor: pointer;
            width: 100%;
            transition: background-color 0.3s;
        `;
        button.onmouseover = () => (button.style.backgroundColor = '#3e8e41');
        button.onmouseout = () => (button.style.backgroundColor = '#4CAF50');

        button.addEventListener('click', () => {

          console.log(`Added ${product.name} to cart`);

        });

        productCard.appendChild(image);
        productCard.appendChild(name);
        productCard.appendChild(price);
        productCard.appendChild(button);
        productsGrid.appendChild(productCard);
      });

      card.appendChild(productsGrid);

      // Free shipping badge (when goal is met)
      if (goalMet) {
        const freeShippingBadge = document.createElement('div');
        freeShippingBadge.textContent = 'FREE SHIPPING';
        freeShippingBadge.style.cssText = `
            text-align: center;
            padding: 12px;
            background-color: #4CAF50;
            color: white;
            border-radius: 4px;
            font-weight: bold;
            margin-top: 10px;
            font-size: 16px;
        `;
        card.appendChild(freeShippingBadge);
      }

      return card;
    }
    // Helper function to create flame mode (BOGO) card
    function createFlameModeCard(campaign, products, goalMet, remaining, goalType) {
      const card = document.createElement('div');
      card.className = 'upsell-card flame-card';
      card.style.padding = '15px';
      card.style.borderRadius = '8px';
      card.style.backgroundColor = '#fff9f0';
      card.style.border = '1px solid #ffe8c4';

      const title = document.createElement('h4');
      title.textContent = '🎁 Free Gift with Purchase';
      title.style.marginTop = '0';
      title.style.marginBottom = '15px';
      title.style.color = '#e67e22';
      card.appendChild(title);

      // Create product grid
      const productGrid = document.createElement('div');
      productGrid.style.display = 'grid';
      productGrid.style.gridTemplateColumns = 'repeat(auto-fill, minmax(200px, 1fr))';
      productGrid.style.gap = '15px';
      productGrid.style.marginBottom = '15px';

      products.forEach((product) => {
        const productCard = document.createElement('div');
        productCard.className = 'flame-product-card';
        productCard.style.padding = '10px';
        productCard.style.borderRadius = '8px';
        productCard.style.backgroundColor = '#fff';
        productCard.style.border = '1px solid #eee';
        productCard.style.cursor = 'pointer';
        productCard.style.transition = 'all 0.3s ease';

        productCard.innerHTML = `
        <label style="display: flex; flex-direction: column; gap: 8px;">
          <div style="display: flex; align-items: center; gap: 10px;">
            <input type="radio" name="reward_product_${campaign.id}" value="${product.variantId}"
              style="transform: scale(1.2); accent-color: #e67e22;" />
            <img src="${product.media || product.variantImage || 'https://via.placeholder.com/80'}"
              alt="${product.title}" width="60" height="60"
              style="object-fit:cover; border-radius: 6px;" />
          </div>
          <div style="flex: 1;">
            <strong style="font-size: 14px;">${product.title}</strong><br/>
            <span style="color: #4CAF50; font-size: 13px;">FREE Gift</span>
          </div>
        </label>
          `;

        // Add hover effect
        productCard.addEventListener('mouseover', () => {
          productCard.style.boxShadow = '0 2px 8px rgba(230, 126, 34, 0.2)';
          productCard.style.borderColor = '#e67e22';
        });

        productCard.addEventListener('mouseout', () => {
          productCard.style.boxShadow = 'none';
          productCard.style.borderColor = '#eee';
        });

        productGrid.appendChild(productCard);
      });

      card.appendChild(productGrid);

      const claimGiftBtn = document.createElement('button');
      claimGiftBtn.textContent = 'Claim Free Gift';
      claimGiftBtn.disabled = !goalMet;
      claimGiftBtn.style.cssText = `
      margin-top: 10px;
      width: 100%;
      padding: 12px;
      background: ${goalMet ? '#e67e22' : '#ccc'};
      color: white;
      border: none;
      border-radius: 8px;
      font-weight: bold;
      cursor: ${goalMet ? 'pointer' : 'not-allowed'};
      font-size: 14px;
      transition: all 0.3s ease;
       `;

      if (goalMet) {
        claimGiftBtn.addEventListener('mouseover', () => {
          claimGiftBtn.style.background = '#d35400';
        });

        claimGiftBtn.addEventListener('mouseout', () => {
          claimGiftBtn.style.background = '#e67e22';
        });

        claimGiftBtn.addEventListener('click', () => {
          const selectedRadio = document.querySelector(`input[name="reward_product_${campaign.id}"]:checked`);
          if (!selectedRadio) {
            alert('Please select a gift first!');
            return;
          }
          addToCart(selectedRadio.value, 1);
        });
      } else {
        claimGiftBtn.textContent =
          goalType === 'quantity'
            ? `Add ${remaining} more items to unlock`
            : `Spend ${remaining.toFixed(2)} MAD more to unlock`;
      }

      card.appendChild(claimGiftBtn);
      return card;
    }

