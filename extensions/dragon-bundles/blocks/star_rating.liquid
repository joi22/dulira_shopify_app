<script>
  document.addEventListener('DOMContentLoaded', async function () {
    const App_Domain = 'https://accomplish-steal-canal-selling.trycloudflare.com';
    const shop = Shopify.shop;
    const productId = '{{ product.id }}';
    const Api = `${App_Domain}/api/add_unlock/${productId}/${shop}`;
    const renderedCampaigns = new Set();

   async function addToCart(variantId, quantity) {
    try {
        const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ 
                items: [{ 
                    id: variantId, 
                    quantity: parseInt(quantity) 
                }] 
            }),
        });

        if (!response.ok) {
            const errorData = await response.json();
            throw new Error(errorData.description || 'Failed to add to cart');
        }

        const cart = await fetch('/cart.js').then((res) => res.json());
        document.dispatchEvent(new CustomEvent('cart:updated', { detail: cart }));
        return cart;
    } catch (error) {
        console.error('Add to cart failed:', error);
        alert(error.message || 'Failed to add item to cart. Please try again.');
        throw error;
    }
}

    // Function to create progress bar for goal-based campaigns
function createProgressBar(campaign, currentValue, goalValue, goalType) {
    const cart_products_quantity = {{ cart.items | json }};

    // Get cart variant IDs
    const cartVariantIds = cart_products_quantity
        .map(item => item.variant_id?.toString())
        .filter(Boolean);

    // Reward product variant IDs
    const rewardProducts = campaign.rewardProducts.map(p => p.variantId?.toString());
    const hasRewardProduct = cartVariantIds.some(id => rewardProducts.includes(id));
console.log(cartVariantIds,"this varient ID ",rewardProducts)
    // Check goal type and reward mode/type
    const validGoalType = ["quantity", "amount"].includes(goalType);
    const validRewardMode = campaign.rewardMode === "fixed";
    const validRewardType = ["discount", "freeshipping"].includes(campaign.rewardType);

    // Common progress calculations
    const percentage = goalValue > 0 ? Math.min(100, (currentValue / goalValue) * 100) : 0;
    const remaining = Math.max(0, goalValue - currentValue);
    const goalMet = remaining <= 0;
    const barColors = campaign.barColors
        ? JSON.parse(campaign.barColors)
        : { primary: '#8575ff', background: '#e0e0e0', goalComplete: '#28e2df' };

    let container = document.createElement('div');
    container.className = 'discount-banner';

    if (hasRewardProduct && validGoalType && validRewardMode && validRewardType) {
        // First branch — reward products already in cart
        const productCardsHTML = (campaign.rewardProducts || []).map((item) => `
            <div class="gift-card unlocked" data-variant-id="${item.variantId}">
                <div class="gift-image">
                    <img src="${item.media}" alt="${item.title || 'Gift'}" />
                </div>
                <div class="gift-info">
                    <div class="gift-title">${item.title || 'Gift'}</div>
                </div>
            </div>
        `).join('');

        container.innerHTML = `
            <div class="discount-header">
                <div class="discount-title">${campaign.goalText || ''}</div>
                <div class="discount-subtitle">
                    ${goalMet 
                        ? '🎁 Gift already in your cart!' 
                        : `You're only ${remaining.toFixed(2)} away`}
                </div>
            </div>

            <div class="products-grid small-gifts">${productCardsHTML}</div>

            <div class="progress-container">
                <div class="progress-bar" 
                    style="width: ${percentage}%; background: ${goalMet ? barColors.goalComplete : barColors.primary}">
                </div>
                <span class="progress-percentage">${Math.round(percentage)}%</span>
            </div>
        `;
    } else {
        // Second branch — upsell free gift
        const rewardVariantIds = (campaign.UpsellFreeGiftProduct || [])
            .map(p => p.variantId?.toString())
            .filter(Boolean);

        const rewardInCart = rewardVariantIds.some(id => cartVariantIds.includes(id));

        const productCardsHTML = (campaign.UpsellFreeGiftProduct || []).map((item) => `
            <div class="gift-card ${goalMet ? 'unlocked' : 'locked'}" data-variant-id="${item.variantId}">
                <div class="gift-image">
                    <img src="${item.media}" alt="${item.title || 'Free Gift'}" />
                </div>
                <div class="gift-info">
                    <div class="gift-title">${item.title || 'Free Gift'}</div>
                    <button class="select-btn" ${!goalMet || rewardInCart ? 'disabled' : ''}>
                        ${rewardInCart ? 'Gift Added' : goalMet ? 'Select Gift' : 'Locked'}
                    </button>
                </div>
            </div>
        `).join('');

        container.innerHTML = `
            <div class="discount-header">
                <div class="discount-title">${campaign.goalText || ''}</div>
                <div class="discount-subtitle">
                    ${goalMet 
                        ? (rewardInCart 
                            ? '🎁 Gift already in your cart!' 
                            : '🎉 Goal reached! Choose your free gift.')
                        : `You're only ${remaining.toFixed(2)} away`}
                </div>
            </div>

            <div class="products-grid small-gifts">${productCardsHTML}</div>

            <div class="progress-container">
                <div class="progress-bar" 
                    style="width: ${percentage}%; background: ${goalMet ? barColors.goalComplete : barColors.primary}">
                </div>
                <span class="progress-percentage">${Math.round(percentage)}%</span>
            </div>
        `;

        // Add click events
        if (goalMet && !rewardInCart) {
            container.querySelectorAll('.gift-card.unlocked .select-btn:not([disabled])').forEach((btn) => {
                btn.addEventListener('click', async (e) => {
                    const variantId = e.target.closest('.gift-card').dataset.variantId;
                    if (!variantId) return;

                    btn.disabled = true;
                    btn.textContent = 'Adding...';

                    try {
                        await addToCart(variantId, 1);
                        btn.textContent = 'Added!';
                        document.dispatchEvent(new CustomEvent('cart:updated'));
                    } catch (err) {
                        console.error('Failed to add gift:', err);
                        btn.textContent = 'Error';
                        btn.disabled = false;
                    }
                });
            });
        }
    }

    return container;
}



    // Function to create product card for fixed reward mode
    function createProductCard(product, rule, goalMet, cartVariantIds, campaign) {
      console.log("=================================>>>>>>>")
      const productCard = document.createElement('div');
      productCard.className = 'bmsm-product-card';
      productCard.style.cssText = `
      text-align: center;
      padding: 10px;
      border: 1px solid #eee;
      border-radius: 8px;
      background: #fff;
      transition: all 0.3s ease;
     `;

      const img = document.createElement('img');
      img.src = product.media;
      img.alt = product.title || 'Product Image';
      img.style.cssText = `
      width: 100%;
      height: auto;
      border-radius: 8px;
      margin-bottom: 10px;
      `;
      productCard.appendChild(img);

      const title = document.createElement('div');
      title.textContent = product.title || 'Product';
      title.style.cssText = 'font-size: 14px; font-weight: 600; margin-bottom: 8px;';
      productCard.appendChild(title);

      if (rule && goalMet) {
        const discount = document.createElement('div');
        discount.textContent =
          rule.discountType === 'percentage'
            ? `Save ${rule.discount}%`
            : `Save ${campaign.currency || 'USD'}${rule.discount}`;
        discount.style.cssText = 'font-size: 14px; color: #6d00c7; margin-bottom: 8px;';
        productCard.appendChild(discount);
      }

      const addButton = document.createElement('button');
      addButton.textContent = cartVariantIds.includes(product.variants?.[0]?.id) ? 'Added' : 'Add to Cart';
      addButton.disabled = cartVariantIds.includes(product.variants?.[0]?.id);
      addButton.style.cssText = `
      padding: 8px 12px;
      background-color: #8575ff;
      color: white;
      border: none;
      border-radius: 6px;
      cursor: ${cartVariantIds.includes(product.variants?.[0]?.id) ? 'not-allowed' : 'pointer'};
     `;
      addButton.onclick = async () => {
        if (!cartVariantIds.includes(product.variants?.[0]?.id)) {
          await addToCart(product.variants?.[0]?.id, 1);
        }
      };
      productCard.appendChild(addButton);

      return productCard;
    }

        
