    function createBOGOCard(campaign, products, goalMet, cartItems, cartVariantIds) {
        const card = document.createElement('div');
        card.className = 'upsell-card bogo-card';
        card.style.cssText = `
          padding: 20px;
          border-radius: 12px;
          background-color: #e6f7ff;
          margin: 15px 0;
          border: 2px solid #0099cc;
          font-family: Arial, sans-serif;
          max-width: 600px;
          margin-left: auto;
          margin-right: auto;
        `;

        const heading = document.createElement('h3');
        heading.textContent = campaign.title || 'Buy One Get One Free';
        heading.style.cssText = `margin-bottom: 10px; font-size: 20px; color: #004466;`;
        card.appendChild(heading);

        // === FIXED MODE ===
        if (campaign.rewardMode === 'fixed') {
          const rules = campaign.bogoRules || [];
          if (!rules.length) return;

          const freeProduct = campaign.bogoFreeItems?.[0];
          const paidProduct = campaign.rewardProducts?.[0];

          if (freeProduct && paidProduct) {
            const container = document.createElement('div');
            container.style.cssText = `
              display: flex;
              justify-content: space-between;
              align-items: center;
              gap: 15px;
              margin: 20px 0;
            `;

            const paidContainer = document.createElement('div');
            paidContainer.style.cssText = 'flex: 1; text-align: center;';

            const paidImg = document.createElement('img');
            paidImg.src = paidProduct.media;
            paidImg.alt = paidProduct.title;
            paidImg.style.cssText = 'width: 100%; max-width: 200px; border-radius: 8px;';

            const paidTitle = document.createElement('p');
            paidTitle.textContent = paidProduct.title;
            paidTitle.style.cssText = 'margin: 8px 0 0 0; font-size: 14px; color: #333;';

            paidContainer.appendChild(paidImg);
            paidContainer.appendChild(paidTitle);
            container.appendChild(paidContainer);

            const plus = document.createElement('span');
            plus.textContent = '+';
            plus.style.cssText = 'font-size: 24px; font-weight: bold; color: #333;';
            container.appendChild(plus);

