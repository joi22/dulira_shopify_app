      padding: 8px;
    }

    .product-card {
      padding: 12px;
    }

    .product-image img {
      height: 180px;
    }

    .product-title {
      font-size: 13px;
    }

    .current-price {
      font-size: 15px;
    }

    .section-title {
      font-size: 16px;
    }
  }
</style>

