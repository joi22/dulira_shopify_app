    }

    .slider-controls {
      gap: 15px;
      margin-top: 20px;
    }

    .slider-btn {
      width: 45px;
      height: 45px;
      font-size: 20px;
    }

    .section-title {
      font-size: 18px;
      margin-bottom: 20px;
    }
  }

  /* Very Small Mobile */
  @media (max-width: 360px) {
