    background: {{block.settings.backgroundcolor}};
    color:{{block.settings.color}}
    padding: 10px 20px;
    font-family: Arial, sans-serif;
    font-size: 14px;
    color: #111;
    position: relative;
  } */
  .announcement-bar .left {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .announcement-bar .left .icon {
    font-size: 16px;
  }
  .announcement-bar .right {
    text-align: right;
  }
  .announcement-bar .highlight {
    color: red;
    font-weight: bold;
  }
  .announcement-bar .countdown {
    font-size: 12px;
    margin-top: 2px;
    color: #333;
  }
</style>
<div>
  <div id="announcement-bars" class="announcement-bar-s" >
    <div class="left">
      <span class="icon">🚚</span>
      <span id="announcement-left-text"></span>
    </div>
    <div class="right">
      <div id="announcement-right-text"></div>
      {% comment %} <div id="announcement-countdown" class="countdown"></div> {% endcomment %}
    </div>
  </div>
</div>

