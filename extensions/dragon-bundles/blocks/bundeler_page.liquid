{{ 'bundler.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bundler.js' | asset_url }}" defer></script>

<div class="deals-wrapper" id="deals-wrapper" data-shop="{{ shop.permanent_domain }}">
  <div class="loading-deals">Loading deals...</div>
</div>

{% schema %}
{
  "name": "Bundle Deals Banner",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Banner Title",
      "default": "Bundle deals"
    },
    {
      "type": "text",
      "id": "shipping_text",
      "label": "Shipping Text",
      "default": "Free shipping on 3+ items"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "BLACK FRIDAY"
    },
    {
      "type": "text",
      "id": "timer_text",
      "label": "Timer Text",
      "default": "Ends: Dec 4, 12:59 (GMT+5)"
    },
    {
      "type": "text",
      "id": "offer_text",
      "label": "Offer Text",
      "default": "Extra 20% off &"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Buy more save more"
    }
  ]
}
{% endschema %}
